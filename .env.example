# ==============================================================================
# NEXORA - Environment Configuration Template
# ==============================================================================
# Copy this file to '.env' in the project root to configure local settings.
# Note: '.env' is listed in .gitignore and will never be committed to Git.

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=8080
# Mode: LOCAL (private offline Ollama on localhost) or PUBLIC (zero-budget cloud PWA with OpenRouter free router)
APP_MODE=LOCAL

# ------------------------------------------------------------------------------
# 2. Local Ollama Settings (Default & Recommended - 100% Private, Free & Offline)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_DEFAULT_MODEL=qwen2.5:7b

# ------------------------------------------------------------------------------
# 3. OpenRouter Cloud AI Settings (Optional - Required for Cloud Models / Public Mode)
# ------------------------------------------------------------------------------
# Get your free API key at: https://openrouter.ai/keys
# Leaving this blank will keep all features running locally via Ollama in LOCAL mode.
# In PUBLIC mode, users can also optionally supply their own client key (BYOK) via Settings.
OPENROUTER_API_KEY=
OPENROUTER_DEFAULT_MODEL=openrouter/free
