
# ==============================================================================
# NEXORA - Git Ignore Configuration
# ==============================================================================

# Compiled Java Bytecode
bin/
out/
build/
target/
*.class

# Temporary and Test Artefacts
tests/*.log
*.log
temp/
tmp/

# Environment Variables & Secrets (CRITICAL)
.env
.env.*
!.env.example
*.key
*.pem
*.secret

# IDE & Editor Configurations
.idea/
.vscode/
*.iml
*.iws
*.ipr
.settings/
.classpath
.project

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Backup & Legacy Safeguards
Personal-AI-Chatbot-PHP-Backup/
*.bak
*.backup

# Runtime Data
# Ignore generated user data, but retain the folder placeholder.
data/*
!data/.gitkeep
!data/README.md

# OS / Crash Dumps
hs_err_pid*.log
replay_pid*.log
